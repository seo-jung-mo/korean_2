  "grammar": [
    {
      "id": "u03-g01",
      "pattern": "-(으)ㄹ래요",
      "explanation": "먹거나 마시고 싶은 것을 묻거나 말할 때 사용해요.",
      "examples": [
        {
          "ko": "저는 따뜻한 국수를 먹을래요.",
          "meaning": "I would like to eat warm noodles."
        },
        {
          "ko": "오늘은 따뜻한 차를 마실래요.",
          "meaning": "I would like to drink warm tea today."
        }
      ],
      "details": {
        "form": "받침 없거나 ㄹ 받침 → -ㄹ래요, 다른 받침 → -을래요",
        "usage": "하고 싶은 일을 말하거나 상대의 의향을 묻습니다.",
        "watchOut": "명령보다는 선택과 의향을 묻는 느낌입니다."
      }
    },
    {
      "id": "u03-g02",
      "pattern": "무슨",
      "explanation": "종류를 물을 때 명사 앞에 사용해요.",
      "examples": [
        {
          "ko": "무슨 음식을 좋아해요?",
          "meaning": "What kind of food do you like?"
        },
        {
          "ko": "무슨 영화를 보고 싶어요?",
          "meaning": "What kind of movie do you want to watch?"
        }
      ],
      "details": {
        "form": "무슨 + 명사",
        "usage": "종류나 내용을 모를 때 명사 앞에 놓아 묻습니다.",
        "watchOut": "‘무엇’은 명사처럼 쓰고, ‘무슨’은 뒤에 명사가 필요합니다."
      }
    }
  ],
