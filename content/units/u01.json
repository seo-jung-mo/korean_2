  "grammar": [
    {
      "id": "u01-g01",
      "pattern": "-고",
      "explanation": "두 동작이나 상태를 이어 말할 때 사용해요. 앞말의 어간에 -고를 붙여요.",
      "examples": [
        {
          "ko": "아침에 산책하고 책을 읽었어요.",
          "meaning": "I took a walk and read a book in the morning."
        },
        {
          "ko": "주말에는 쉬고 친구를 만나요.",
          "meaning": "On weekends I rest and meet friends."
        },
        {
          "ko": "저는 음악을 듣고 동생은 책을 읽어요.",
          "meaning": "I listen to music, and my sibling reads a book."
        }
      ],
      "details": {
        "form": "동사·형용사 어간 + -고",
        "usage": "두 행동이나 상태를 나란히 이어 말합니다. 앞뒤의 주어가 같을 수도, 다를 수도 있습니다.",
        "watchOut": "단순히 이어 말할 때 쓰며, 반드시 원인과 결과를 뜻하지는 않습니다."
      }
    },
    {
      "id": "u01-g02",
      "pattern": "그런데",
      "explanation": "앞에서 한 말과 다른 상황을 이어 말할 때 사용해요.",
      "examples": [
        {
          "ko": "오늘은 쉬는 날이에요. 그런데 일이 조금 있어요.",
          "meaning": "Today is a day off. But I have a little work."
        },
        {
          "ko": "친구를 만나고 싶어요. 그런데 시간이 없어요.",
          "meaning": "I want to see my friend. But I don't have time."
        },
        {
          "ko": "날씨가 좋아요. 그런데 바람이 많이 불어요.",
          "meaning": "The weather is nice. But it is very windy."
        }
      ],
      "details": {
        "form": "문장. 그런데 문장.",
        "usage": "앞에서 말한 상황과 다르거나 예상 밖인 내용을 새 문장으로 이어 줍니다.",
        "watchOut": "-고처럼 어간에 붙이지 않고 문장 사이에 따로 씁니다."
      }
    }
  ],
