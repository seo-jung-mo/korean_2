  "grammar": [
    {
      "id": "u13-g01",
      "pattern": "-(으)ㄹ 때",
      "explanation": "어떤 일이 일어나는 시간이나 상황을 말해요.",
      "examples": [
        {
          "ko": "기분이 안 좋을 때 산책해요.",
          "meaning": "I take a walk when I feel down."
        },
        {
          "ko": "기분이 좋을 때 노래를 들어요.",
          "meaning": "I listen to music when I am happy."
        }
      ],
      "details": {
        "form": "어간: 받침 없거나 ㄹ 받침 → -ㄹ 때, 다른 받침 → -을 때",
        "usage": "어떤 상황이나 시간이 일어날 때 하는 행동을 말합니다.",
        "watchOut": "‘때’ 앞의 표현을 한 덩어리로 읽어 보세요."
      }
    },
    {
      "id": "u13-g02",
      "pattern": "-(으)러 가다",
      "explanation": "어떤 장소에 가는 목적을 말해요.",
      "examples": [
        {
          "ko": "친구를 만나러 카페에 가요.",
          "meaning": "I go to a café to meet a friend."
        },
        {
          "ko": "친구를 만나러 도서관에 가요.",
          "meaning": "I go to the library to meet a friend."
        }
      ],
      "details": {
        "form": "동사 어간: 받침 없거나 ㄹ 받침 → -러, 다른 받침 → -으러 + 가다",
        "usage": "어떤 일을 하기 위해 장소로 이동한다고 말합니다.",
        "watchOut": "앞에는 목적이 되는 행동, 뒤에는 가다·오다 같은 이동 동사가 옵니다."
      }
