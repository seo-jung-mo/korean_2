  "grammar": [
    {
      "id": "u02-g01",
      "pattern": "못",
      "explanation": "동사 앞에 놓아 할 수 없거나 하지 못하는 일을 말해요.",
      "examples": [
        {
          "ko": "저는 수영을 못 해요.",
          "meaning": "I cannot swim."
        },
        {
          "ko": "오늘은 일이 있어서 모임에 못 가요.",
          "meaning": "I cannot go to the gathering because I have work."
        }
      ],
      "details": {
        "form": "못 + 동사",
        "usage": "능력이나 상황 때문에 어떤 행동을 할 수 없음을 말합니다.",
        "watchOut": "스스로 하지 않기로 한 ‘안’과 구별해 보세요. ‘못 가요’는 갈 수 없다는 뜻입니다."
      }
    },
    {
      "id": "u02-g02",
      "pattern": "-아서/어서",
      "explanation": "앞의 일이 뒤의 일의 이유가 될 때 사용해요.",
      "examples": [
        {
          "ko": "날씨가 좋아서 자전거를 타요.",
          "meaning": "I ride a bike because the weather is nice."
        },
        {
          "ko": "비가 와서 집에서 쉬어요.",
          "meaning": "It is raining, so I am resting at home."
        }
      ],
      "details": {
        "form": "어간의 끝 모음 ㅏ·ㅗ → -아서, 그 밖 → -어서, 하다 → 해서",
        "usage": "앞의 내용이 뒤의 내용의 이유가 될 때 사용합니다.",
        "watchOut": "이유를 말할 때는 앞 절에 보통 과거 시제 -았/었-을 넣지 않습니다."
      }
    }
  ],
